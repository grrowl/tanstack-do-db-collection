{
  "name": "tanstack-do-db-on-demand",
  "main": "src/worker.ts",
  "compatibility_date": "2026-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "ITEMS_DO", "class_name": "ItemsDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ItemsDO"] }],
  "assets": { "directory": "./public", "binding": "ASSETS" }
}
